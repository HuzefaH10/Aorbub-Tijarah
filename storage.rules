rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── User profile photos ──
    // Users can read/write only their own profile photo directory
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Business logos ──
    // Authenticated users can read any business logo (for team views)
    // Only write their own business's logo
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == businessId;
    }

  }
}
