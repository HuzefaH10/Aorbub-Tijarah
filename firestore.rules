rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPro(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.plan == 'pro';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function incomingBusinessId() {
      return request.resource.data.businessId;
    }

    function existingBusinessId() {
      return resource.data.businessId;
    }

    // ─── User profiles ───
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Business documents ───
    match /businesses/{businessId} {
      allow read, write: if isAuthenticated();
      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ─── Settings & Counters ───
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════
    //  FREE + PRO COLLECTIONS
    // ═══════════════════════════════════════════════════
    match /products/{document=**} { allow read, write: if isAuthenticated(); }
    match /bills/{document=**} { allow read, write: if isAuthenticated(); }
    match /credits/{document=**} { allow read, write: if isAuthenticated(); }
    match /entries/{document=**} { allow read, write: if isAuthenticated(); }
    match /events/{document=**} { allow read, write: if isAuthenticated(); }
    match /stockLogs/{document=**} { allow read, write: if isAuthenticated(); }
    match /stockHistory/{document=**} { allow read, write: if isAuthenticated(); }
    match /categories/{document=**} { allow read, write: if isAuthenticated(); }
    match /templates/{document=**} { allow read, write: if isAuthenticated(); }
    match /milestones/{document=**} { allow read, write: if isAuthenticated(); }

    // ═══════════════════════════════════════════════════
    //  PRO-ONLY COLLECTIONS (Backend write protection)
    //  Reads are allowed so aggregation queries don't crash.
    //  The frontend explicitly blocks Free users from pages.
    // ═══════════════════════════════════════════════════
    
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isPro(incomingBusinessId());
      allow delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isPro(incomingBusinessId());
      allow delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isPro(incomingBusinessId());
      allow delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    match /auditLog/{logId} {
      allow read: if isAuthenticated(); // fixes RunAggregationQuery 403 Forbidden
      allow create: if isAuthenticated(); // Allow any plan to preserve audit trails
      allow update, delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    // ─── Team & History ───
    match /loginHistory/{historyId} { allow read, write: if isAuthenticated(); }
    match /teamMembers/{memberId} { allow read, write: if isAuthenticated(); }
    match /teamInvites/{inviteId} { allow read, write: if isAuthenticated(); }
  }
}
