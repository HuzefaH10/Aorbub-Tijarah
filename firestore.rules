// ═══════════════════════════════════════════════════════════════════════════════
// Aorbub Tijarah — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// TEST CASES (verify after deployment):
//
// 1. Free user navigates to /invoices → redirected to home (frontend guard via ProRoute)
// 2. Free user calls Firestore invoices collection manually → permission-denied (this ruleset)
// 3. Pro user accesses all collections → full access, no blocks
// 4. Free user accesses products/bills/credits → full access, no blocks
// 5. Plan field tampered on frontend to 'pro' → server rules still block based on
//    actual Firestore plan field in /businesses/{businessId}
//
// ARCHITECTURE NOTE:
//   Data is stored in top-level collections with a `businessId` field,
//   NOT as subcollections under /businesses/{businessId}.
//   Rules therefore check request.resource.data.businessId or resource.data.businessId
//   against the plan stored in /businesses/{businessId}.
//
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: check the plan on the business doc ───
    function isPro(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.plan == 'pro';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // For writes, the businessId is in the incoming data
    function incomingBusinessId() {
      return request.resource.data.businessId;
    }

    // For reads/deletes, the businessId is in the existing doc
    function existingBusinessId() {
      return resource.data.businessId;
    }

    // ─── User profiles ───
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Business documents ───
    match /businesses/{businessId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      // Subcollections under businesses (billing, notifications, products from onboarding)
      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // ─── Settings ───
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Counters (invoice numbering etc.) ───
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════
    //  FREE + PRO COLLECTIONS (always accessible)
    // ═══════════════════════════════════════════════════

    // Products — accessible to all authenticated users
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Bills (sales) — accessible to all authenticated users
    match /bills/{billId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Credits — accessible to all authenticated users
    match /credits/{creditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Entries (legacy data entry) — accessible to all
    match /entries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // Events / Calendar — accessible to all
    match /events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // Stock logs — accessible to all
    match /stockLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Stock history — accessible to all
    match /stockHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }

    // Categories — accessible to all
    match /categories/{categoryId} {
      allow read, write: if isAuthenticated();
    }

    // Templates — accessible to all
    match /templates/{templateId} {
      allow read, write: if isAuthenticated();
    }

    // Milestones — accessible to all
    match /milestones/{milestoneId} {
      allow read, write: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════
    //  PRO-ONLY COLLECTIONS
    //  Read and write blocked for free plan users.
    //  The businessId field on the document is used to
    //  look up the plan on the corresponding business doc.
    // ═══════════════════════════════════════════════════

    // Invoices — Pro only
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && isPro(existingBusinessId());
      allow create: if isAuthenticated() && isPro(incomingBusinessId());
      allow update, delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    // Expenses — Pro only
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isPro(existingBusinessId());
      allow create: if isAuthenticated() && isPro(incomingBusinessId());
      allow update, delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    // Suppliers — Pro only
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isPro(existingBusinessId());
      allow create: if isAuthenticated() && isPro(incomingBusinessId());
      allow update, delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    // Audit Log — Pro only
    match /auditLog/{logId} {
      allow read: if isAuthenticated() && isPro(existingBusinessId());
      allow create: if isAuthenticated();  // Allow writes from any plan so audit trail isn't broken
      allow update, delete: if isAuthenticated() && isPro(existingBusinessId());
    }

    // Login history — readable by all (security section), write by authenticated
    match /loginHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }

    // Team members / invites
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }
    match /teamInvites/{inviteId} {
      allow read, write: if isAuthenticated();
    }
  }
}
